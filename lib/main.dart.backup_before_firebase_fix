class AppData {
  static final FirebaseFirestore _firestore =
      FirebaseFirestore.instance;

  static List<String> classes = [
    'BSCS - 1A',
    'BSCS - 1B',
    'BSCS - 2A',
  ];

  static List<String> lecturers = [
    'Dr. Ahmad Khan',
    'Ms. Fatima Ali',
    'Mr. Bilal Hussain',
    'Dr. Sara Ahmed',
  ];

  static List<String> subjects = [
    'Programming Fundamentals',
    'Data Structures',
    'Mathematics',
    'English',
    'Database Systems',
    'Computer Networks',
  ];

  static List<String> rooms = [
    'Room 101',
    'Room 102',
    'Room 103',
    'Computer Lab',
  ];

  static List<String> timeSlots = [
    '09:00 - 10:00',
    '10:00 - 11:00',
    '11:00 - 12:00',
    '12:00 - 01:00',
  ];

  static List<String> workingDays = [
    'Monday',
    'Tuesday',
    'Wednesday',
    'Thursday',
    'Friday',
  ];

  static Map<String, String> subjectLecturers = {
    'Programming Fundamentals': 'Dr. Ahmad Khan',
    'Data Structures': 'Ms. Fatima Ali',
    'Mathematics': 'Mr. Bilal Hussain',
    'English': 'Dr. Sara Ahmed',
    'Database Systems': 'Dr. Ahmad Khan',
    'Computer Networks': 'Ms. Fatima Ali',
  };

  static List<TimetableEntry> timetable = [];
  static List<TimetableEntry> confirmedTimetable = [];
  static List<TimetableEntry> previousTimetable = [];

  static bool timetableConfirmed = false;

  static String currentLecturerName = '';

  // ==========================================================
  // LOAD EVERYTHING
  // ==========================================================

  static Future<void> loadFromFirestore() async {
    try {
      final settingsDoc = await _firestore
          .collection('app_data')
          .doc('settings')
          .get();

      if (settingsDoc.exists) {
        final data = settingsDoc.data();

        if (data != null) {
          if (data['classes'] is List) {
            classes = List<String>.from(data['classes']);
          }

          if (data['subjects'] is List) {
            subjects = List<String>.from(data['subjects']);
          }

          if (data['lecturers'] is List) {
            lecturers = List<String>.from(data['lecturers']);
          }

          if (data['rooms'] is List) {
            rooms = List<String>.from(data['rooms']);
          }

          if (data['timeSlots'] is List) {
            timeSlots = List<String>.from(data['timeSlots']);
          }

          if (data['workingDays'] is List) {
            workingDays = List<String>.from(data['workingDays']);
          }

          if (data['subjectLecturers'] is Map) {
            subjectLecturers = Map<String, String>.from(
              data['subjectLecturers'],
            );
          }
        }
      }

      await loadConfirmedTimetableFromFirestore();
      await loadPreviousTimetableFromFirestore();
    } catch (e) {
      debugPrint(
        'Could not load data from Firebase: $e',
      );
    }
  }

  // ==========================================================
  // LOAD CONFIRMED TIMETABLE
  // ==========================================================

  static Future<List<TimetableEntry>>
      loadConfirmedTimetableFromFirestore() async {
    try {
      final doc = await _firestore
          .collection('app_data')
          .doc('confirmed_timetable')
          .get();

      if (!doc.exists) {
        confirmedTimetable = [];
        timetable = [];
        timetableConfirmed = false;
        return [];
      }

      final data = doc.data();

      if (data == null || data['entries'] is! List) {
        confirmedTimetable = [];
        timetable = [];
        timetableConfirmed = false;
        return [];
      }

      final entries = _entriesFromFirestore(
        data['entries'],
      );

      confirmedTimetable = entries;
      timetable = List<TimetableEntry>.from(entries);
      timetableConfirmed = entries.isNotEmpty;

      return entries;
    } catch (e) {
      debugPrint(
        'Could not load confirmed timetable: $e',
      );
      return [];
    }
  }

  // ==========================================================
  // LOAD PREVIOUS TIMETABLE
  // ==========================================================

  static Future<List<TimetableEntry>>
      loadPreviousTimetableFromFirestore() async {
    try {
      final doc = await _firestore
          .collection('app_data')
          .doc('previous_timetable')
          .get();

      if (!doc.exists) {
        previousTimetable = [];
        return [];
      }

      final data = doc.data();

      if (data == null || data['entries'] is! List) {
        previousTimetable = [];
        return [];
      }

      final entries = _entriesFromFirestore(
        data['entries'],
      );

      previousTimetable = entries;

      return entries;
    } catch (e) {
      debugPrint(
        'Could not load previous timetable: $e',
      );
      return [];
    }
  }

  // ==========================================================
  // CONVERT FIRESTORE ENTRIES
  // ==========================================================

  static List<TimetableEntry> _entriesFromFirestore(
    dynamic value,
  ) {
    if (value is! List) {
      return [];
    }

    final List<TimetableEntry> result = [];

    for (final item in value) {
      if (item is Map) {
        final converted = item.map(
          (key, value) => MapEntry(
            key.toString(),
            value,
          ),
        );

        result.add(
          TimetableEntry.fromMap(
            Map<String, dynamic>.from(converted),
          ),
        );
      }
    }

    return result;
  }

  // ==========================================================
  // SAVE SETTINGS
  // ==========================================================

  static Future<void> saveSettings() async {
    try {
      await _firestore
          .collection('app_data')
          .doc('settings')
          .set({
        'classes': classes,
        'subjects': subjects,
        'lecturers': lecturers,
        'rooms': rooms,
        'timeSlots': timeSlots,
        'workingDays': workingDays,
        'subjectLecturers': subjectLecturers,
        'updatedAt': FieldValue.serverTimestamp(),
      });

      debugPrint(
        'Settings saved successfully.',
      );
    } catch (e) {
      debugPrint(
        'Could not save settings: $e',
      );
    }
  }

  // ==========================================================
  // SAVE CONFIRMED TIMETABLE
  // ==========================================================

  static Future<void> saveConfirmedTimetable() async {
    try {
      await _firestore
          .collection('app_data')
          .doc('confirmed_timetable')
          .set({
        'confirmed': true,
        'entries': confirmedTimetable
            .map(
              (entry) => entry.toMap(),
            )
            .toList(),
        'updatedAt': FieldValue.serverTimestamp(),
      });

      debugPrint(
        'Confirmed timetable saved successfully.',
      );
    } catch (e) {
      debugPrint(
        'Could not save confirmed timetable: $e',
      );
      rethrow;
    }
  }

  // ==========================================================
  // SAVE PREVIOUS TIMETABLE
  // ==========================================================

  static Future<void> savePreviousTimetable() async {
    try {
      await _firestore
          .collection('app_data')
          .doc('previous_timetable')
          .set({
        'entries': previousTimetable
            .map(
              (entry) => entry.toMap(),
            )
            .toList(),
        'hasPreviousTimetable':
            previousTimetable.isNotEmpty,
        'updatedAt': FieldValue.serverTimestamp(),
      });

      debugPrint(
        'Previous timetable saved: '
        '${previousTimetable.length} entries.',
      );
    } catch (e) {
      debugPrint(
        'Could not save previous timetable: $e',
      );
      rethrow;
    }
  }
}

