class GeneticAlgorithmPage
    extends StatefulWidget {
  const GeneticAlgorithmPage({
    super.key,
  });

  @override
  State<GeneticAlgorithmPage>
      createState() =>
          _GeneticAlgorithmPageState();
}

class _GeneticAlgorithmPageState
    extends State<
        GeneticAlgorithmPage> {
  bool generating = false;

  String status =
      'Ready to generate timetable.';

  Future<void> generateTimetable() async {
    if (AppData.classes.isEmpty) {
      setState(() {
        status =
            'Please add at least one class.';
      });
      return;
    }

    if (AppData.subjects.isEmpty) {
      setState(() {
        status =
            'Please add at least one subject.';
      });
      return;
    }

    if (AppData.lecturers.isEmpty) {
      setState(() {
        status =
            'Please add at least one lecturer.';
      });
      return;
    }

    if (AppData.rooms.isEmpty) {
      setState(() {
        status =
            'No rooms available.';
      });
      return;
    }

    if (AppData.timeSlots.isEmpty) {
      setState(() {
        status =
            'No time slots available.';
      });
      return;
    }

    if (AppData.workingDays.isEmpty) {
      setState(() {
        status =
            'No working days available.';
      });
      return;
    }

    setState(() {
      generating = true;
      status =
          'Generating timetable...';
    });

    try {
      // Save current confirmed timetable
      // as previous timetable.
      if (AppData
          .confirmedTimetable
          .isNotEmpty) {
        AppData.previousTimetable =
            List<TimetableEntry>.from(
          AppData.confirmedTimetable,
        );

        await AppData
            .savePreviousTimetable();
      }

      final random = Random();

      final generated =
          <TimetableEntry>[];

      int globalCounter = 0;

      for (final className
          in AppData.classes) {
        final shuffledSubjects =
            List<String>.from(
          AppData.subjects,
        );

        shuffledSubjects.shuffle(
          random,
        );

        final maxSubjects = min(
          shuffledSubjects.length,
          AppData.timeSlots.length,
        );

        for (
          int i = 0;
          i < maxSubjects;
          i++
        ) {
          final subject =
              shuffledSubjects[i];

          final day =
              AppData.workingDays[
                  globalCounter %
                      AppData
                          .workingDays
                          .length];

          final time =
              AppData.timeSlots[
                  globalCounter %
                      AppData
                          .timeSlots
                          .length];

          final room =
              AppData.rooms[
                  globalCounter %
                      AppData.rooms
                          .length];

          final lecturer =
              AppData.lecturers[
                  globalCounter %
                      AppData
                          .lecturers
                          .length];

          generated.add(
            TimetableEntry(
              className: className,
              subject: subject,
              lecturer: lecturer,
              room: room,
              day: day,
              time: time,
            ),
          );

          globalCounter++;
        }
      }

      await Future.delayed(
        const Duration(
          milliseconds: 800,
        ),
      );

      AppData.timetable =
          generated;

      if (!mounted) return;

      setState(() {
        status =
            'Timetable generated successfully. '
            '${generated.length} entries created.';
      });
    } catch (e) {
      if (!mounted) return;

      setState(() {
        status =
            'Generation failed: $e';
      });
    } finally {
      if (mounted) {
        setState(() {
          generating = false;
        });
      }
    }
  }

  Future<void> confirmTimetable() async {
    if (AppData.timetable.isEmpty) {
      ScaffoldMessenger.of(context)
          .showSnackBar(
        const SnackBar(
          content: Text(
            'Generate a timetable first.',
          ),
        ),
      );
      return;
    }

    try {
      AppData.confirmedTimetable =
          List<TimetableEntry>.from(
        AppData.timetable,
      );

      AppData.timetableConfirmed =
          true;

      await AppData
          .saveConfirmedTimetable();

      if (!mounted) return;

      ScaffoldMessenger.of(context)
          .showSnackBar(
        const SnackBar(
          content: Text(
            'Timetable confirmed and saved to Firebase successfully.',
          ),
        ),
      );

      setState(() {
        status =
            'Timetable confirmed and saved successfully.';
      });
    } catch (e) {
      if (!mounted) return;

      ScaffoldMessenger.of(context)
          .showSnackBar(
        SnackBar(
          content: Text(
            'Could not save timetable: $e',
          ),
        ),
      );
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text(
          'Generate Timetable',
        ),
      ),
      body: Padding(
        padding: const EdgeInsets.all(25),
        child: Column(
          children: [
            Card(
              child: Padding(
                padding:
                    const EdgeInsets.all(20),
                child: Column(
                  children: [
                    const Icon(
                      Icons.auto_awesome,
                      size: 60,
                      color:
                          Colors.indigo,
                    ),
                    const SizedBox(
                      height: 15,
                    ),
                    const Text(
                      'Smart Timetable Generator',
                      style: TextStyle(
                        fontSize: 24,
                        fontWeight:
                            FontWeight.bold,
                      ),
                      textAlign:
                          TextAlign.center,
                    ),
                    const SizedBox(
                      height: 10,
                    ),
                    const Text(
                      'Generate a flexible timetable using '
                      'intelligent scheduling logic.',
                      textAlign:
                          TextAlign.center,
                    ),
                    const SizedBox(
                      height: 25,
                    ),
                    SizedBox(
                      width:
                          double.infinity,
                      child:
                          ElevatedButton.icon(
                        onPressed:
                            generating
                                ? null
                                : generateTimetable,
                        icon: generating
                            ? const SizedBox(
                                height: 20,
                                width: 20,
                                child:
                                    CircularProgressIndicator(
                                  strokeWidth:
                                      2,
                                ),
                              )
                            : const Icon(
                                Icons
                                    .play_arrow,
                              ),
                        label: Text(
                          generating
                              ? 'Generating...'
                              : 'Generate Timetable',
                        ),
                      ),
                    ),
                    const SizedBox(
                      height: 10,
                    ),
                    SizedBox(
                      width:
                          double.infinity,
                      child:
                          OutlinedButton.icon(
                        onPressed:
                            AppData
                                    .timetable
                                    .isEmpty
                                ? null
                                : confirmTimetable,
                        icon:
                            const Icon(
                          Icons
                              .check_circle,
                        ),
                        label:
                            const Text(
                          'Confirm Timetable',
