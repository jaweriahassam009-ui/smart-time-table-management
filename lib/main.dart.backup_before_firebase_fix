class _LecturerTimetablePageState
    extends State<
        LecturerTimetablePage> {
  List<TimetableEntry> entries =
      [];

  bool loading = true;

  String? error;

  @override
  void initState() {
    super.initState();
    loadTimetable();
  }

  Future<void> loadTimetable() async {
    setState(() {
      loading = true;
      error = null;
    });

    try {
      final user =
          FirebaseAuth.instance.currentUser;

      if (user == null) {
        throw Exception(
          'No lecturer is logged in.',
        );
      }

      final query =
          await FirebaseFirestore
              .instance
              .collection('users')
              .where(
                'email',
                isEqualTo: user.email,
              )
              .limit(1)
              .get();

      if (query.docs.isEmpty) {
        throw Exception(
          'Lecturer record not found.',
        );
      }

      final data =
          query.docs.first.data();

      final lecturerName =
          data['name']
                  ?.toString()
                  .trim() ??
              '';

      if (lecturerName.isEmpty) {
        throw Exception(
          'Lecturer name is missing from Firestore.',
        );
      }

      AppData.currentLecturerName =
          lecturerName;

      await AppData
          .loadConfirmedTimetableFromFirestore();

      final filtered =
          AppData.confirmedTimetable
              .where(
        (entry) {
          return entry.lecturer
                  .trim()
                  .toLowerCase() ==
              lecturerName
                  .trim()
                  .toLowerCase();
        },
      ).toList();

      if (!mounted) return;

      setState(() {
        entries = filtered;
        loading = false;
      });
    } catch (e) {
      if (!mounted) return;

      setState(() {
        loading = false;
        error = e.toString();
      });
    }
